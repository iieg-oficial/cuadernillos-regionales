% El pie va DENTRO de la tabla, en \endlastfoot, para que longtable cuente su altura
% al decidir donde parte. Asi el corte lo toma longtable durante la composicion y salen
% (continua), (continuacion) y los encabezados; si el pie no cabe, baja con filas.
% \tablefooter es la version suelta, para los pies de grafica y de mapa.
\newcommand{\tablefooterbody}[1]{\noindent{\footnotesize
  \renewcommand{\arraystretch}{1.0}%
  \begin{tabularx}{\linewidth}[t]{@{}l@{\hspace{0.5em}}X@{}}#1\end{tabularx}%
  \renewcommand{\arraystretch}{1.5}}}
\newcommand{\tablefooter}[1]{\vspace{-28pt}\tablefooterbody{#1}}
\newcommand{\tablefooterrow}[2]{%
  \multicolumn{#1}{@{}p{\linewidth}@{}}{\tablefooterbody{#2}}\\}

% \LT@output ya sabe bajar el ultimo pie con marcas de continuacion si no cabe, pero
% mide solo la ALTURA de \LT@lastfoot e ignora su profundidad. Con un pie de varias
% lineas eso se queda corto y el pie termina solo en la pagina siguiente. Los dos
% parches le suman \dp\LT@lastfoot a la comparacion.
\makeatletter
\patchcmd{\LT@output}{\ifdim \ht\LT@lastfoot>\ht\LT@foot}
  {\ifdim \dimexpr\ht\LT@lastfoot+\dp\LT@lastfoot\relax>\ht\LT@foot}
  {}{\PackageWarning{cuadernillos}{no se pudo parchar LT@output (guarda)}}
\patchcmd{\LT@output}{\advance\dimen@-\ht\LT@lastfoot}
  {\advance\dimen@-\ht\LT@lastfoot\advance\dimen@-\dp\LT@lastfoot}
  {}{\PackageWarning{cuadernillos}{no se pudo parchar LT@output (medida)}}

% Cuando decide que no cabe, longtable manda TODA la pagina con \LT@foot y abre la
% siguiente con \LT@head y el pie: encabezado y pie solos, sin una sola fila. Con el
% \vsplit se parte el material a la altura que si cabe, asi que las filas sobrantes
% bajan con el pie en vez de dejar la pagina vacia.
\patchcmd{\LT@output}{\setbox\@cclv\vbox{\unvbox\z@\copy\LT@foot\vss}}
  {\splittopskip\z@\vbadness\@M\vfuzz\maxdimen
   \setbox\tw@\vsplit\z@ to\dimen@
   \setbox\@cclv\vbox{\unvbox\tw@\copy\LT@foot\vss}}
  {}{\PackageWarning{cuadernillos}{no se pudo parchar LT@output (vsplit)}}
\patchcmd{\LT@output}{\setbox\z@\vbox{\box\LT@head}}
  {\setbox\z@\vbox{\box\LT@head\unvbox\z@}}
  {}{\PackageWarning{cuadernillos}{no se pudo parchar LT@output (resto)}}
\makeatother

