\newlength{\mapheadroom}
\setlength{\mapheadroom}{1.6cm}
% \mapatitulo imprime el titulo en su lugar; \mapatitulo* solo lo guarda para que lo
% dibuje \mapageo. Los mapas de geografia se escalan con \adjustbox y, cuando los limita
% la altura, salen mas angostos que el recuadro con sangrado: si el titulo se imprimiera
% por su cuenta quedaria alineado al recuadro y no al mapa.
\makeatletter
\newsavebox{\mapa@box}
\newcommand{\mapa@titulo}{}
\newcommand{\mapa@guardar}[1]{%
  \refstepcounter{mapa}%
  \gdef\mapa@titulo{Mapa \themapa. #1}}
\newcommand{\mapa@imprimir}[2][0pt]{%
  \refstepcounter{mapa}%
  \noindent\hspace*{-#1}%
  \parbox{\dimexpr\linewidth+#1+#1\relax}{%
    \color{colorTexto}\raggedright Mapa \themapa. #2}\par
  \vspace{-\parskip}\vspace{1pt}}
\newcommand{\mapatitulo}{\@ifstar\mapa@guardar\mapa@imprimir}
% #1 ancho maximo de la imagen, #2 sangrado, #3 ruta. El titulo va en un minipage del
% ancho REAL del mapa, medido con el \sbox: si al mapa lo limita la altura sale mas
% angosto que su caja y un titulo impreso aparte quedaria alineado a la caja, no al mapa.
\newcommand{\mapabloque}[3]{%
  \sbox\mapa@box{\adjustbox{max width=#1,
    max height=\dimexpr\textheight-\mapheadroom\relax}{\includegraphics{#3}}}%
  \noindent\hspace*{-#2}%
  \makebox[\dimexpr\linewidth+#2+#2\relax][c]{%
    \begin{minipage}{\wd\mapa@box}%
      \noindent{\color{colorTexto}\raggedright\mapa@titulo}\par\vspace{1pt}%
      \usebox\mapa@box
    \end{minipage}}\par}
\newcommand{\mapageo}[1]{%
  \mapabloque{\dimexpr\textwidth+2\mapbleed\relax}{\mapbleed}{#1}}
\newcommand{\mapafijo}[2][0.95\textwidth]{\mapabloque{#1}{0pt}{#2}}
\makeatother
